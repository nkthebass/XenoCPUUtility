<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>CPUUtilityHybrid</RootNamespace>
    <AssemblyName>XenoCPUUtility</AssemblyName>
    <ApplicationVersion>1.9.7.0</ApplicationVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ApplicationIcon>www\installer.ico</ApplicationIcon>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
    <PublishTrimmed>false</PublishTrimmed>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.1901.177" />
    <PackageReference Include="System.Management" Version="7.0.0" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="www\**\*" />
  </ItemGroup>

  <!-- Compile HLSL shaders -->
  <Target Name="CompileShaders" BeforeTargets="Build">
    <Exec Command="fxc.exe /T cs_5_0 /Fo bin\RayTraceShader.cso RayTraceShader.hlsl" ContinueOnError="true" />
    <ItemGroup>
      <EmbeddedResource Include="bin\RayTraceShader.cso" />
    </ItemGroup>
  </Target>
</Project>